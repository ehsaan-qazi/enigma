# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side Only Service Role Key (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Python AI Service (FastAPI) Configuration
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=your-internal-ai-service-secret

# Google Gemini / LLM Provider Key (Optional if managed by AI service)
GEMINI_API_KEY=
